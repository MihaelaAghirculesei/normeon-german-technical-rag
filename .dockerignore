# Build context of deploy/Dockerfile (the repository root): only what the
# image is built from -- the frontend sources, the backend's pyproject,
# src/, prompts, price list and migrations -- and no secrets.
**
!deploy/start.sh
!frontend/
!backend/pyproject.toml
!backend/src/
!backend/prompts/
!backend/pricing.yaml
!backend/alembic.ini
!backend/migrations/
frontend/node_modules/
frontend/dist/
frontend/.angular/
**/__pycache__/
**/.env
**/.env.*
